<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:background="#FFFFFF" android:padding="16dp" android:elevation="3dp"
    android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/tvAvatar" android:text="U" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:gravity="center" android:background="#0B5D3B" android:layout_width="56dp" android:layout_height="56dp"/>
    <LinearLayout android:orientation="vertical" android:paddingLeft="14dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content">
        <TextView android:id="@+id/tvNama" android:text="Nama Santri" android:textStyle="bold" android:textSize="17sp" android:textColor="#111111" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvInfo" android:text="Kelas 1 • 0 Juz • WA: -" android:textSize="13sp" android:textColor="#666666" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvBadge" android:text="KELAS 1" android:textSize="11sp" android:textStyle="bold" android:textColor="#0B5D3B" android:background="#E6F2EB" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnDetail" android:text="👁  DETAIL" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#0B5D3B" android:layout_weight="1" android:layout_marginRight="6dp" android:layout_width="0dp" android:layout_height="38dp"/>
            <Button android:id="@+id/btnHapus" android:text="🗑  HAPUS" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#D32F2F" android:layout_weight="1" android:layout_marginLeft="6dp" android:layout_width="0dp" android:layout_height="38dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
