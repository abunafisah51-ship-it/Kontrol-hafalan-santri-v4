<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp"
    android:gravity="center" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="#FFFFFF">
    <TextView android:text="🌙 BUKOM SANTRI" android:textSize="28sp" android:textStyle="bold" android:textColor="#0B5D3B" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="Buku Komunikasi Hafalan &amp; Orang Tua" android:textSize="14sp" android:layout_marginBottom="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btnGuru" android:text="Saya Guru" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnWali" android:text="Saya Wali" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:id="@+id/tvLabel" android:text="Masukkan PIN Guru" android:textSize="16sp" android:layout_marginTop="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etInput" android:hint="PIN Guru - contoh 1234" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnMasuk" android:text="▶️ MASUK" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Wali hanya bisa melihat, tidak bisa mengubah data." android:textSize="12sp" android:layout_marginTop="16dp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
