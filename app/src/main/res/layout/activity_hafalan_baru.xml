<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F1F5F2">
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:padding="20dp" android:background="#0B5D3B" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="HAFALAN BARU" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Target: 3 Bagian / Hari" android:textColor="#D1E7DD" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvTanggal" android:text="📅 Tanggal" android:textColor="#FFD700" android:textStyle="bold" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/tvInfo" android:text="Memuat santri..." android:textSize="12sp" android:textColor="#666666" android:layout_marginBottom="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Nama Santri" android:textStyle="bold" android:textColor="#0B5D3B" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Spinner android:id="@+id/spSantri" android:background="#FFFFFF" android:padding="12dp" android:layout_marginTop="6dp" android:layout_marginBottom="14dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="52dp"/>
        <TextView android:text="Surah / Juz" android:textStyle="bold" android:textColor="#0B5D3B" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etSurah" android:hint="Contoh: Al-Mulk / Juz 30" android:background="#FFFFFF" android:padding="14dp" android:layout_marginTop="6dp" android:layout_marginBottom="14dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="52dp"/>
        <TextView android:text="Dari Ayat - Sampai Ayat" android:textStyle="bold" android:textColor="#0B5D3B" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_marginTop="6dp" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <EditText android:id="@+id/etDari" android:hint="Dari: 1" android:inputType="number" android:background="#FFFFFF" android:padding="14dp" android:layout_weight="1" android:layout_marginRight="8dp" android:elevation="2dp" android:layout_width="0dp" android:layout_height="52dp"/>
            <EditText android:id="@+id/etSampai" android:hint="Sampai: 12" android:inputType="number" android:background="#FFFFFF" android:padding="14dp" android:layout_weight="1" android:layout_marginLeft="8dp" android:elevation="2dp" android:layout_width="0dp" android:layout_height="52dp"/>
        </LinearLayout>
        <TextView android:text="Nilai Hafalan" android:textStyle="bold" android:textColor="#0B5D3B" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Spinner android:id="@+id/spNilai" android:background="#FFFFFF" android:padding="12dp" android:layout_marginTop="6dp" android:layout_marginBottom="20dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="52dp"/>
        <Button android:id="@+id/btnSimpan" android:text="✅  Simpan Hafalan" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp" android:backgroundTint="#0B5D3B" android:layout_width="match_parent" android:layout_height="56dp"/>
        <TextView android:text="Hafalan akan tersimpan dan bisa dilihat Wali di menu Laporan." android:textSize="12sp" android:textColor="#888888" android:gravity="center" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
</ScrollView>
