<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F1F5F2">
    <LinearLayout android:orientation="vertical" android:padding="16dp" android:background="#0B5D3B" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="DAFTAR SANTRI" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Kelola santri aktif  •  Hapus jika lulus / keluar" android:textColor="#D1E7DD" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvTotal" android:text="Total 0 Santri" android:textColor="#FFD700" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <EditText android:id="@+id/etCari" android:hint="🔍 Cari nama santri..." android:background="@android:drawable/edit_text" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/containerSantri" android:orientation="vertical" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
