<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="#F1F5F2" android:padding="20dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="🕌  BAITUL QURAN" android:textColor="#FFD700" android:textStyle="bold" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="TAMBAH SANTRI" android:textColor="#0B5D3B" android:textStyle="bold" android:textSize="26sp" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="NAMA SANTRI" android:textStyle="bold" android:textColor="#0B5D3B" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etNama" android:hint="Contoh: Umar" android:background="#FFFFFF" android:padding="14dp" android:layout_marginTop="6dp" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="52dp"/>
