    <EditText android:id="@+id/etKelas" android:hint="Contoh: 1" android:background="#FFFFFF" android:padding="14dp" android:layout_marginTop="6dp" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="52dp"/>
